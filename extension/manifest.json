{
  "manifest_version": 3,
  "name": "Health Fact Checker",
  "version": "2.3.3",
  "description": "Highlight any medical claim for instant AI fact-checking",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*",
    "https://your-backend-domain.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}